# ============================================================
# CONFIGURAÇÃO DO AMBIENTE DE TRADUÇÃO WH40K PT-BR
# ============================================================
# Copie este arquivo para .env e preencha suas chaves.
# Nunca comite o arquivo .env com chaves reais.
# ============================================================

# --- PROVEDOR PRINCIPAL DE IA ---
# Opções: ollama | groq | google | deep_translator
# Recomendado: 'ollama' (local, sem limite) ou 'groq' (cloud, gratuito 14.400 req/dia)
TRANSLATION_PROVIDER=ollama

# --- OLLAMA (local, sem custo, sem limite) ---
# Instalar: curl -fsSL https://ollama.com/install.sh | sudo sh
# Baixar modelo: ollama pull llama3.1:8b
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# --- GROQ (cloud gratuito: 14.400 req/dia, muito rápido) ---
# Cadastro gratuito em: https://console.groq.com/
# Modelos gratuitos recomendados: llama-3.1-8b-instant, mixtral-8x7b-32768
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# --- GOOGLE GEMINI (cloud gratuito: 1.500 req/dia) ---
# Cadastro em: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-1.5-flash

# --- CONFIGURAÇÕES DO PIPELINE ---
# Tamanho do lote por requisição de IA
BATCH_SIZE=10
# Número de tentativas antes de fallback
MAX_RETRIES=3
# Delay em segundos entre lotes (evita rate limit)
DELAY_BETWEEN_BATCHES=0.5
# Arquivo com checkpoint de progresso
CHECKPOINT_FILE=.translation_checkpoint.json
